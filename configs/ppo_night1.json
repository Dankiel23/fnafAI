{
    "algorithm": "ppo",
    "night": 1,
    "total_timesteps": 500000,
    "n_envs": 4,
    "full_observability": true,
    "step_duration": 1.0,
    "policy_kwargs": {
        "net_arch": {"pi": [128, 128], "vf": [128, 128]}
    },
    "hyperparameters": {
        "learning_rate": 0.0003,
        "n_steps": 2048,
        "batch_size": 64,
        "n_epochs": 10,
        "gamma": 0.99,
        "gae_lambda": 0.95,
        "clip_range": 0.2,
        "ent_coef": 0.01,
        "vf_coef": 0.5,
        "max_grad_norm": 0.5
    },
    "reward_shaping": {
        "survival_bonus": 0.01,
        "death_penalty": -100.0,
        "win_bonus": 100.0,
        "power_penalty_scale": 0.005,
        "defensive_bonus": 0.02,
        "waste_penalty": 0.01
    }
}
